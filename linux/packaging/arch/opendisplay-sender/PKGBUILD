# Maintainer: Philip Poloczek <839848+peetzweg@users.noreply.github.com>
#
# AUR source package for od-sender, built from a `linux-v*` release tag.
# It links the system FFmpeg, so it survives FFmpeg soname bumps by being
# rebuilt (rebuild-detector flags it); see linux/SENDER-PLAN.md §3.5.
#
#   ./bump.sh 0.1.0-beta.1      new tag: pkgver, sha256sums, .SRCINFO
#   ./from-checkout.sh          build this checkout's HEAD instead of the tag
#
# The desktop entry and user unit ship inside the tag tarball, next to this
# file, so the AUR repository only needs PKGBUILD and .SRCINFO.

pkgname=opendisplay-sender
# Pre-releases map to pacman's own ordering, which sorts a letter run below
# the plain release: tag 0.1.0-beta.1 -> pkgver 0.1.0beta1, and
# `vercmp 0.1.0beta1 0.1.0` = -1, so the final 0.1.0 replaces the beta.
# (`0.1.0_beta.1` would sort *above* 0.1.0.) bump.sh sets both lines.
pkgver=0.1.0beta1
_tag=linux-v0.1.0-beta.1
pkgrel=1
pkgdesc="OpenDisplay sender for Wayland: extend a Linux desktop onto an iPhone, iPad, Android device or Mac"
arch=('x86_64' 'aarch64')
url="https://opendisplay.app"
license=('GPL-3.0-only')
depends=(
  'ffmpeg'       # libavcodec (libx264, V4L2 M2M) and libswscale; Wayland is pure Rust
  'libpipewire'  # KDE backend: KWin virtual outputs arrive as PipeWire streams
  'gcc-libs'
  'glibc'
)
makedepends=('cargo' 'pkgconf' 'clang')  # clang: bindgen for ffmpeg-sys-next
makedepends_x86_64=('nasm')              # OpenH264's x86 assembly (fallback encoder)
# No provides=(): it names packages, and nothing depends on one called
# od-sender (the binary's name).
options=('!lto')  # cargo profile handles LTO

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/peetzweg/opendisplay/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "opendisplay-${_tag}/linux"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "opendisplay-${_tag}/linux"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export OD_SENDER_VERSION="${_tag#linux-v}"  # no .git in the tarball
  cargo build --frozen --release -p od-sender
}

check() {
  cd "opendisplay-${_tag}/linux"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export OD_SENDER_VERSION="${_tag#linux-v}"  # no .git in the tarball
  # Unit tests only: nothing here needs a compositor or the network.
  cargo test --frozen --release -p od-sender
}

package() {
  cd "opendisplay-${_tag}"
  local _pkg=linux/packaging/arch/opendisplay-sender
  install -Dm755 linux/target/release/od-sender "${pkgdir}/usr/bin/od-sender"
  install -Dm644 "${_pkg}/od-sender.desktop" "${pkgdir}/usr/share/applications/od-sender.desktop"
  install -Dm644 "${_pkg}/od-sender@.service" "${pkgdir}/usr/lib/systemd/user/od-sender@.service"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 PROTOCOL.md "${pkgdir}/usr/share/doc/${pkgname}/PROTOCOL.md"
}
